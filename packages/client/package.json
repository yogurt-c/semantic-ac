{
  "name": "@semantic-ac/client",
  "version": "0.0.1",
  "description": "Lightweight TypeScript SDK for context-aware, typo-tolerant search autocomplete",
  "license": "MIT",
  "homepage": "https://github.com/yogurt-c/semantic-ac/tree/main/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogurt-c/semantic-ac.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/yogurt-c/semantic-ac/issues"
  },
  "author": "yogurt-c",
  "keywords": [
    "autocomplete",
    "search",
    "typo-correction",
    "debounce",
    "typescript-sdk"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
